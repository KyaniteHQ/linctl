# The linctl binary that render.sh builds here. The fixture stand-in used by
# render-fixture.sh is source, not a build artifact, so it stays tracked.
linctl
!fixture/linctl
*.local.*

# hyperframes composition: keep the source (index.html, plan, brief, render config),
# ignore generated/heavy artifacts and copied media
launch/composition/node_modules/
launch/composition/renders/
launch/composition/.hyperframes/
launch/composition/.claude/
launch/composition/assets/
launch/composition/skills-lock.json
launch/composition/AGENTS.md
launch/composition/CLAUDE.md

# readme-hero composition: same rule. index.html, meta.json, hyperframes.json and
# package.json are the source; everything below is generated or scaffolded.
readme-hero/node_modules/
readme-hero/renders/
readme-hero/snapshots/
readme-hero/.hyperframes/
readme-hero/.claude/
readme-hero/assets/
readme-hero/skills-lock.json
readme-hero/AGENTS.md
readme-hero/CLAUDE.md
